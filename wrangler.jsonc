{
	"name": "sistema-reloj-control",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-26",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"secrets": {
		"required": ["DATABASE_URL", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET"]
	}
}
